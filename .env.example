# Copy to .env.local for local development. Never commit real keys.

# Gemini Developer API key. Required for Gemini Omni video edits, the Gemini File API
# (Slot Scout, scene brand-safety analysis, exposure scoring) and Gemini TTS audio ads.
# Without it, InScene falls back to deterministic heuristics and canonical clips.
GEMINI_API_KEY=

# Optional: route analysis calls through Vertex AI instead of the Developer API.
# Only used when GEMINI_API_KEY is empty. Video upload/analysis needs the Developer API.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional model overrides.
INSCENE_ANALYSIS_MODEL=gemini-3.5-flash
INSCENE_TTS_MODEL=gemini-2.5-flash-preview-tts

# Where the JSON store keeps campaigns, ad events and scout/safety caches.
# Defaults to ./data locally; the Docker image sets /app/data.
DATA_DIR=./data
